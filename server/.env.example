# Copy this file to `.env` and set DB_PASSWORD plus unique API keys.
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=shamba_direct_db
DB_PORT=3306

# Generate a different random key for each consumer. Keep the values private.
API_KEY_RING_PARTNER=
API_KEY_TEAM=
API_RATE_LIMIT_MAX=100

# Salama API (used only by the backend; never put the Salama key in the client).
SALAMA_API_BASE_URL=http://localhost:5001/api
SALAMA_API_KEY=
SALAMA_API_KEY_HEADER=X-API-Key
SALAMA_TIMEOUT_MS=10000